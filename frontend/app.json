{
  "expo": {
    "name": "FieldForce CRM",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.fmcgcrmhub.wmktos",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Track visits and capture shop location",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Track your route during work hours",
        "NSCameraUsageDescription": "Capture shop photos and visiting cards",
        "NSPhotoLibraryUsageDescription": "Attach shop photos from your gallery",
        "LSApplicationQueriesSchemes": ["whatsapp"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#4D7C0F"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.emergent.fmcgcrmhub.wmktos",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA",
        "READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#1C1917"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Track visits and capture shop location"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Attach shop photos from your gallery",
          "cameraPermission": "Capture shop photos and visiting cards"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
